{
  "name": "touchgrass",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "server": "tsx server/src/index.ts",
    "server:dev": "tsx watch server/src/index.ts",
    "seed": "tsx server/src/seed.ts",
    "dev:all": "concurrently -n api,web -c green,blue \"npm run server:dev\" \"npm run dev\""
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.9.1",
    "@tailwindcss/vite": "^4.3.3",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "framer-motion": "^13.0.0",
    "lenis": "^1.3.26",
    "lucide-react": "^1.28.0",
    "mongodb": "^6.21.0",
    "pg": "^8.23.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2",
    "sql.js": "^1.14.1",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@oxlint/binding-linux-x64-gnu": "^1.77.0",
    "@oxlint/linux-x64-gnu": "^1.43.0",
    "@prisma/client": "^7.9.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/sql.js": "^1.4.11",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^9.2.4",
    "oxlint": "^1.75.0",
    "prisma": "^7.9.1",
    "tsx": "^4.23.11",
    "typescript": "^5.9.0",
    "vite": "^6.4.3"
  }
